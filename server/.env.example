# Somente no backend. Copie as configurações necessárias para server/.env (ignorado pelo Git).
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_DAILY_REQUEST_LIMIT=10
AI_MONTHLY_REQUEST_LIMIT=100
AI_REQUESTS_PER_MINUTE=3
AI_MAX_PROMPT_CHARS=1500
AI_MAX_QUESTIONS_PER_REQUEST=5
AI_MAX_OUTPUT_TOKENS=2500
AI_GLOBAL_MONTHLY_BUDGET_USD=25
AI_BUDGET_WARNING_PERCENT=70
# A flag ai.questions_generation também precisa de liberação na governança existente.
# Não substitui as demais configurações necessárias do servidor (JWT, banco, uploads etc.).
